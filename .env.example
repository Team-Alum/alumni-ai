# =============================================================
# Alumni AI Server Configuration
# =============================================================
PORT=8000
HOST=127.0.0.1
DEBUG=True
DATABASE_PATH=data/alumni_ai.db

# Supabase Postgres connection string (production — enables Postgres mode)
# Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=

# Optional Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=


# =============================================================
# 10-Tier Auto-Fallback AI Provider Keys (All 100% Free Tiers)
# Alumni AI tries each provider sequentially. If a provider hits
# rate-limit, quota, or network error, it automatically falls back!
# =============================================================

# Tier 1: OpenCode Zen Reasoning AI Key (Key No. 1)
OPENCODE_API_KEY=
OPENCODE_ENDPOINT=https://opencode.ai/zen/v1/chat/completions
OPENCODE_MODEL=space-bunny-free

# Key No. 3: OpenCode Zen Attachment Observer & Fallback Brain
OPENCODE_ATTACHMENT_KEY=
OPENCODE_FALLBACK_KEY=

# Tier 2: OpenRouter Free Models (Free at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free

# Tier 3: Qwen (Alibaba DashScope or OpenCode endpoint)
QWEN_API_KEY=
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-turbo

# Tier 4: Ollama Local/Server (100% Free - zero API keys required)
ENABLE_OLLAMA=True
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Tier 5: Google Gemini Free Tier (Free at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tier 6: Groq Cloud (Free at: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 7: Cerebras Cloud (Free at: https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Tier 8: Mistral AI (Free at: https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Tier 9: GitHub Models / Azure (Free at: https://github.com/settings/tokens)
GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini

# Tier 10: Alumni AI Built-in Neural Brain (Offline Heuristic Engine - 100% Uptime Always)
ENABLE_OFFLINE_FALLBACK=True

# =============================================================
# Sarvam AI Neural Voice Engine (Bulbul Model) - Voice Assistant 'May'
# =============================================================
SARVAM_API_KEY=
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
SARVAM_SPEAKER=ishita
SARVAM_MODEL=bulbul:v3
SARVAM_LANG=en-IN
