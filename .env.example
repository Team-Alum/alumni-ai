# =============================================================
# Alumni AI Server Configuration
# =============================================================
PORT=8000
HOST=127.0.0.1
DEBUG=True
DATABASE_PATH=data/alumni_ai.db

# Supabase Postgres connection string (production — enables Postgres mode)
# Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=

# Optional Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=

# =============================================================
# AI Engine Configuration
# -------------------------------------------------------------
# AI provider credentials and model identifiers are configured
# privately (locally in .env, or in the hosting provider's
# environment settings). They are intentionally not documented
# in this public template.
#
# See app/config.py for the exact environment variable names.
# =============================================================

# =============================================================
# Neural Voice Engine — Voice Assistant 'May'
# =============================================================
SARVAM_API_KEY=
